{
  "schema_version": 2,
  "required_capabilities": [
    "custom_pages",
    "structured_arguments"
  ],
  "workspace_title": "ChatGPT 订阅",
  "pages": [
    {
      "id": "connection",
      "title": "订阅连接",
      "icon": "settings",
      "mode": "custom",
      "entry": "web/connection.html",
      "queries": {
        "status": {
          "api": "connection_status"
        }
      },
      "actions": {
        "start": {
          "api": "connection_start"
        },
        "finish": {
          "api": "connection_finish",
          "parameters": {
            "callback_url": {
              "type": "string",
              "required": true,
              "max_length": 12000
            }
          }
        },
        "cancel": {
          "api": "connection_cancel",
          "parameters": {
            "attempt": {
              "type": "string",
              "required": true,
              "max_length": 100
            }
          }
        },
        "models": {
          "api": "connection_models"
        },
        "logout": {
          "api": "connection_logout"
        },
        "write_catalog": {
          "api": "connection_write_catalog",
          "confirmation": "确认备份共享模型库并写入选中的订阅模型？不会修改分工；写入期间请勿在其他页面保存配置。",
          "parameters": {
            "model_ids": {
              "type": "array",
              "required": true,
              "max_items": 100,
              "items": {
                "type": "string",
                "max_length": 191
              }
            },
            "generation": {
              "type": "integer",
              "required": true
            }
          }
        }
      }
    }
  ]
}
