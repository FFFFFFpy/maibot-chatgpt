{
  "manifest_version": 2,
  "id": "github.ffffffpy.chatgpt_subscription",
  "plugin_type": "provider",
  "name": "MaiBot ChatGPT Subscription Provider",
  "description": "独立 SIWC 会话；文本、Planner 函数工具与视觉输入",
  "version": "0.5.0",
  "author": {
    "name": "Helw",
    "url": "https://github.com/FFFFFFpy"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/FFFFFFpy/maibot-chatgpt"
  },
  "host_application": {
    "min_version": "1.4.8",
    "max_version": "1.4.8"
  },
  "sdk": {
    "min_version": "2.23.0",
    "max_version": "2.23.0"
  },
  "dependencies": [
    {"type": "python_package", "name": "tomlkit", "version_spec": ">=0.13.3,<1"},
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.28.1,<0.29"
    },
    {
      "type": "python_package",
      "name": "PyJWT",
      "version_spec": ">=2.15.1,<3"
    },
    {
      "type": "python_package",
      "name": "cryptography",
      "version_spec": ">=50.0.2,<51"
    }
  ],
  "llm_providers": [
    {
      "client_type": "maibot.chatgpt.subscription",
      "version": "0.5.0"
    }
  ],
  "capabilities": [],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "_locales",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
